[Unit]
Description=LAN Blog (Flask + gunicorn)
After=network.target

[Service]
Type=simple
User=zoro
Group=zoro
WorkingDirectory=/home/zoro/work/lan-blog
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/zoro/work/lan-blog/.venv/bin/gunicorn -w 2 --threads 4 -b 0.0.0.0:8000 --access-logfile logs/access.log --error-logfile logs/error.log app:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
